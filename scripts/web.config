<?xml version="1.0" encoding="UTF-8"?>
<!--
  Command-line tools: their PHP must never run over HTTP. The IIS half of the
  .htaccess beside this file, which IIS does not read - see it for the reasoning.

  Refused by extension rather than the whole directory, so the inventory agent
  (Invoke-AssetInventory.ps1, no secrets in it) can still be downloaded.

  ⚠️ NO <handlers><clear/> - the handlers section is locked at server level on a
  default IIS install and clearing it answers HTTP 500.19 for everything below.
  requestFiltering is not locked, and refusing the extension is enough.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".php" allowed="false" />
          <add fileExtension=".phtml" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
