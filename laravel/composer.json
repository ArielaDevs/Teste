{
  "name": "freeitsm/laravel-bridge",
  "type": "project",
  "description": "Laravel migration scaffold for FreeITSM modular system.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
    ],
    "test": [
      "@php artisan test"
    ],
    "serve": [
      "@php artisan serve"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
